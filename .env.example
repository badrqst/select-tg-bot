# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Iron API Configuration
IRON_API_KEY=your_iron_api_key_here

# Iron API Base URL - Check your Iron documentation for correct URL
# Try these options if getting 404 errors:
# Option 1 (default): https://api.sandbox.iron.xyz/api
# Option 2: https://api.sandbox.iron.xyz
# Option 3: https://sandbox.iron.xyz/api
# Option 4: https://api.sandbox.iron.xyz/v1
IRON_API_BASE_URL=https://api.sandbox.iron.xyz/api

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./select.db
# For PostgreSQL: postgresql+asyncpg://user:password@localhost/dbname
